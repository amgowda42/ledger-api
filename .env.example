# Copy to .env and adjust. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./ledger.db

JWT_SECRET_KEY=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

COOKIE_NAME=access_token
# Set to true when served over HTTPS
COOKIE_SECURE=false
# lax | strict | none  (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
