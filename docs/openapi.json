          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "TransactionCreate": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "amount": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Description"
          },
          "reference_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reference Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "amount",
          "description",
          "reference_id"
        ],
        "title": "TransactionCreate"
      },
      "TransactionPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionRead"
            },
            "type": "array",
            "title": "Items"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "type": "object",
        "required": [
          "items",
          "pagination"
        ],
        "title": "TransactionPage"
      },
      "TransactionRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "account_id": {
            "type": "integer",
            "title": "Account Id"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "reference_id": {
            "type": "string",
            "title": "Reference Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "account_id",
          "type",
          "amount",
          "description",
          "reference_id",
          "created_at"
        ],
        "title": "TransactionRead"
      },
      "TransactionResult": {
        "properties": {
          "transaction": {
            "$ref": "#/components/schemas/TransactionRead"
          },
          "already_exists": {
            "type": "boolean",
            "title": "Already Exists"
          },
          "account_balance": {
            "type": "integer",
            "title": "Account Balance"
          }
        },
        "type": "object",
        "required": [
          "transaction",
          "already_exists",
          "account_balance"
        ],
        "title": "TransactionResult",
        "description": "Response to POST. `already_exists` is true when reference_id was seen before\nfor this account: nothing was created and the balance did not change."
      },
      "TransactionType": {
        "type": "string",
        "enum": [
          "credit",
          "debit"
        ],
        "title": "TransactionType"
      },
      "TransferCreate": {
        "properties": {
          "source_account_id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 1.0,
            "title": "Source Account Id"
          },
          "destination_account_id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 1.0,
            "title": "Destination Account Id"
          },
          "amount": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "reference_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reference Id"
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Description",
            "default": "Transfer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_account_id",
          "destination_account_id",
          "amount",
          "reference_id"
        ],
        "title": "TransferCreate"
      },
      "TransferRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "source_account_id": {
            "type": "integer",
            "title": "Source Account Id"
          },
          "destination_account_id": {
            "type": "integer",
            "title": "Destination Account Id"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "reference_id": {
            "type": "string",
            "title": "Reference Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_account_id",
          "destination_account_id",
          "amount",
          "description",
          "reference_id",
          "created_at"
        ],
        "title": "TransferRead"
      },
      "TransferResult": {
        "properties": {
          "transfer": {
            "$ref": "#/components/schemas/TransferRead"
          },
          "already_exists": {
            "type": "boolean",
            "title": "Already Exists"
          },
          "source_balance": {
            "type": "integer",
            "title": "Source Balance"
          }
        },
        "type": "object",
        "required": [
          "transfer",
          "already_exists",
          "source_balance"
        ],
        "title": "TransferResult",
        "description": "`already_exists` is true when this reference_id was already used by the source\naccount: nothing moved and the original transfer is returned. Only the source\nbalance is shown; the destination balance belongs to someone else."
      },
      "UserRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "title": "UserRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    }
  }
}
